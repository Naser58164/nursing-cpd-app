/**
 * ENCOR 2026 — Seed.gs
 * ------------------------------------------------------------------
 * seedSheets(): creates every tab and loads the approved seed
 * (encor2026_seed.json). Idempotent: safe to run again.
 *   - Reference tabs (Stations, Rotation, Timetable, Scales, Checklists,
 *     ChecklistItems, OSCEScenarios, OSCEItems) are rewritten from the seed.
 *   - Participants: missing participant numbers are added; names/staff IDs
 *     already imported by the Admin are kept. Seed names are null → blank.
 *   - Config: missing keys are added with the defaults from the brief; existing values kept.
 *   - OSCEUnits: written only if empty (Admin may edit).
 *   - NEVER writes scores, users, e-mails or names.
 *
 * Where the seed comes from (first found wins):
 *   1. A global ENCOR_SEED object in SeedData.gs (generated by dev/build-seed-gs.js), or
 *   2. An HTML file named "seed" in this project containing the raw JSON text.
 */

function loadSeed_() {
  if (typeof ENCOR_SEED !== 'undefined' && ENCOR_SEED) return JSON.parse(JSON.stringify(ENCOR_SEED));
  var txt = '';
  try { txt = HtmlService.createHtmlOutputFromFile('seed').getContent(); } catch (e) { txt = ''; }
  if (!txt) throw new Error('Seed not found. Add SeedData.gs (ENCOR_SEED) or an HTML file named "seed" with encor2026_seed.json.');
  return JSON.parse(txt);
}

/** Main setup entry point — run from the Apps Script editor. */
function seedSheets() {
  var n = Logic.normaliseSeed(loadSeed_());
  var check = Logic.validateSeed(n);
  if (!check.ok) throw new Error('Seed failed validation — nothing written:\n' + check.errors.join('\n'));

  var lock = LockService.getScriptLock(); lock.waitLock(30000);
  try {
    REQ_CACHE_ = {};
    Object.keys(SCHEMA).forEach(function (name) { sheet_(name); });   // create every tab with headers

    rewrite_('Stations', n.stations);
    rewrite_('Rotation', n.rotation);
    rewrite_('Timetable', n.timetable);
    rewrite_('Checklists', n.checklists);
    rewrite_('ChecklistItems', n.checklistItems);
    rewrite_('OSCEScenarios', n.osceScenarios);
    rewrite_('OSCEItems', n.osceItems);
    rewrite_('Scales', n.scoring_scale.map(function (s) { return { scale: 'checklist', score: s.score, label: s.label, meaning: s.meaning || '' }; })
      .concat(n.team_rubric_scale.map(function (s) { return { scale: 'team_rubric', score: s.score, label: s.label, meaning: s.meaning || '' }; })));
    if (!readTable_('OSCEUnits').length) appendRows_('OSCEUnits', n.osceUnits);

    // Participants: add missing numbers only (names/staff IDs stay as imported).
    var have = {}; readTable_('Participants').forEach(function (p) { have[p.participant_no] = 1; });
    appendRows_('Participants', n.roster.filter(function (p) { return !have[p.participant_no]; }));

    // Config: add missing keys only.
    var cfg = {}; readTable_('Config').forEach(function (c) { cfg[c.key] = 1; });
    var osceTimes = osceTimesFromTimetable_(n.timetable);
    appendRows_('Config', CONFIG_DEFAULTS.filter(function (c) { return !cfg[c[0]]; }).map(function (c) {
      var v = c[1];
      if (c[0] === 'osce_start_time_day2') v = osceTimes['2'] || '';
      if (c[0] === 'osce_start_time_day3') v = osceTimes['3'] || '';
      return { key: c[0], value: v, note: c[2] };
    }));

    // Remove the default empty "Sheet1" if present and unused.
    var s1 = ss_().getSheetByName('Sheet1');
    if (s1 && s1.getLastRow() === 0 && ss_().getSheets().length > 1) ss_().deleteSheet(s1);
  } finally { lock.releaseLock(); }

  var report = verifySeed_();
  Logger.log(JSON.stringify(report, null, 2));
  return report;
}

/** OSCE start = start of a timetable row whose topic says OSCE (or the "OCSE" spelling used in the seed). */
function osceTimesFromTimetable_(tt) {
  var out = {};
  tt.forEach(function (t) { if (/O[SC]{2}E/i.test(t.topic) && !out[t.day]) out[t.day] = Logic.parseTimeRange(t.time).start; });
  return out;
}

/** Replace all data rows of a reference tab. */
function rewrite_(name, objs) {
  var sh = sheet_(name), h = SCHEMA[name];
  if (sh.getLastRow() > 1) sh.getRange(2, 1, sh.getLastRow() - 1, Math.max(h.length, sh.getLastColumn())).clearContent();
  delete REQ_CACHE_[name];
  if (!objs.length) return;
  sh.getRange(2, 1, objs.length, h.length).setNumberFormat('@')
    .setValues(objs.map(function (o) { return h.map(function (k) { return o[k] === undefined || o[k] === null ? '' : String(o[k]); }); }));
  delete REQ_CACHE_[name];
}

/**
 * Acceptance tests 1–4 against the LIVE sheet: counts, maxima, roster and
 * character-for-character equality of every checklist / OSCE text with the seed.
 */
function verifySeed_() {
  REQ_CACHE_ = {};
  var n = Logic.normaliseSeed(loadSeed_());
  var seedCheck = Logic.validateSeed(n);
  var mismatches = [];
  function cmp(label, seedRows, sheetRows, keyFn, fields) {
    var idx = {}; sheetRows.forEach(function (r) { idx[keyFn(r)] = r; });
    seedRows.forEach(function (s) {
      var r = idx[keyFn(s)];
      if (!r) { mismatches.push(label + ' ' + keyFn(s) + ': missing in sheet'); return; }
      fields.forEach(function (f) { if (String(r[f]) !== String(s[f])) mismatches.push(label + ' ' + keyFn(s) + '.' + f + ' differs from seed'); });
    });
    if (sheetRows.length !== seedRows.length) mismatches.push(label + ': sheet has ' + sheetRows.length + ' rows, seed has ' + seedRows.length);
  }
  cmp('ChecklistItems', n.checklistItems, readTable_('ChecklistItems'), function (r) { return r.checklist_id + '#' + r.item_no; }, ['text']);
  cmp('Checklists', n.checklists, readTable_('Checklists'), function (r) { return r.checklist_id; }, ['title', 'max_score']);
  cmp('OSCEItems', n.osceItems, readTable_('OSCEItems'), function (r) { return r.osce_id + '#' + r.section + '#' + r.role_no + '#' + r.code; }, ['text', 'role_title']);
  cmp('Rotation', n.rotation, readTable_('Rotation'), function (r) { return r.day + r.round + r.group; }, ['station', 'time']);
  cmp('Stations', n.stations, readTable_('Stations'), function (r) { return r.day + r.station; }, ['topic', 'checklist_id', 'facilitator', 'subject_expert', 'organizer']);
  var parts = readTable_('Participants');
  n.roster.forEach(function (p) {
    var r = parts.filter(function (x) { return x.participant_no === p.participant_no; })[0];
    if (!r) mismatches.push('Participant ' + p.participant_no + ' missing');
    else if (r.group !== p.group || r.team !== p.team) mismatches.push('Participant ' + p.participant_no + ' group/team differs from seed');
  });
  return { ok: seedCheck.ok && !mismatches.length, counts: seedCheck.counts, seedErrors: seedCheck.errors, seedIssues: seedCheck.issues, sheetMismatches: mismatches };
}
